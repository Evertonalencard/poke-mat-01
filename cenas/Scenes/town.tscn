perguntas = [{
"alts": ["Raul não é engenheiro e não gosta de fazer cálculos.", "Raul é engenheiro e não gosta de fazer cálculos.", "Se Raul gosta de fazer cálculos, então ele não é engenheiro.", "Se Raul é engenheiro, então ele não gosta de fazer cálculos.", "Raul não é engenheiro e gosta de fazer cálculos."],
"correta": 1,
"eq": "Analise a proposição abaixo e, em seguida, assinale a alternativa contendo a sua correta negação:“Se Raul é engenheiro, então ele gosta de fazer cálculos.”."
}, {
"alts": ["Aline joga vôlei se e somente se Micael não joga vídeo game.", "Se Micael joga vídeo game, então Aline joga vôlei", "Micael não joga videogame nem Aline joga vôlei.", "Se Aline não joga vôlei, então Micael joga vídeo game.", "Aline não joga vôlei e Micael joga vídeo game"],
"correta": 1,
"eq": "Dizer que “Aline joga vôlei ou Micael não joga vídeo game” é logicamente equivalente a dizer que:"
}, {
"alts": ["Os dados não foram limpos. ", "Os dados foram limpos e a análise não está correta.", "Não é verdade que os dados foram limpos.", "A análise está correta e os dados não foram limpos. ", "Os dados não foram limpos ou a análise está correta."],
"correta": 1,
"eq": "A negação da proposição composta “Se os dados foram limpos, então a análise está correta” é:"
}, {
"alts": ["Uma contradição, pois é sempre falsa. ", "Uma tautologia, pois é sempre verdadeira. ", "Uma tautologia, pois seu valor lógico depende de p.", "Uma contradição, pois seu valor lógico só depende de q.", "Uma tautologia, pois apresenta valores falsos e verdadeiros."],
"correta": 1,
"eq": "A: (p ⋁ ¬q) ⋀ (¬p ⋁ q) → (p ↔ q)Assinale a alternativa que apresenta corretamente a classificação lógica da proposição A."
}, {
"alts": ["Algum marinheiro não resiste ao canto da sereia.", "Algum marinheiro resiste ao canto da sereia.", "Nenhum marinheiro não resiste ao canto da sereia.", "Todos os marinheiros não resistem ao canto da sereia. ", "Todos os marinheiros resistem ao canto da sereia."],
"correta": 1,
"eq": "Assinale a opção que apresenta a negação da proposição “Nenhum marinheiro resiste ao canto da sereia”."
}, {
