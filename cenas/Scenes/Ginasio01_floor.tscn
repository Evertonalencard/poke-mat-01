perguntas = [{
"alts": ["Se P ⊂ Q e Q ⊂ P então P = Q ", " Se P ∩ Q = ∅ então P ∪ Q = ∅", "Se P ≠ Q então P ∩ Q = ∅", " Se P ∪ Q = P então P ⊂ Q", " Se P ⊂ Q então P = Q"],
"correta": 0,
"eq": "Sejam P e Q subconjuntos não vazios de R. Assinale a alternativa correta:"
}, {
"alts": ["C ∩ D = {-3, -2}", " C ∪ D = {-1, 0, 1}", "D - C = {2, 3}", "C - D = {0, 1}", "(C ∪ D) ∩ C = {2, 3}"],
"correta": 2,
"eq": "Dados os conjuntos C = {-3, -2, -1, 0, 1} e D = {0, 1, 2, 3}, assinale a afirmação verdadeira:"
}, {
"alts": [" F ∩ G = {2, 3}", "F ∪ G = {0, 1, 4}", "G - F = {2, 3}", " F - G = {5, 6}", "(F ∪ G) ∩ G = {0, 1}"],
"correta": 0,
"eq": "Dados os conjuntos F = {0, 1, 2, 3, 4} e G = {2, 3, 5, 6}, assinale a afirmação verdadeira:"
}, {
"alts": ["7", "5", "4", "6", "2"],
"correta": 0,
"eq": "Durante uma pesquisa com 25 pessoas, 14 afirmaram torcer para o Ceará, 10 para o Fortaleza e 6 para os dois times. Quantas pessoas não torcem para nenhum dos dois times?"
}, {
"alts": ["4200", "2500", "3200", "1600", "3000"],
"correta": 2,
"eq": "Em um estádio havia 20.000 pessoas. Destas, 13.000 eram brasileiros, 8.400 eram alemães e 4.600 torciam tanto pela seleção brasileira quanto pela alemã. Quantas pessoas não torciam nem para a seleção brasileira nem para a alemã?"
}, {
"alts": ["1h", "1h30min", "1h20min", "2h", "3h"],
"correta": 1,
"eq": "90 minutos equivalem a?"
}, {
"alts": ["200 m", "300 m", "400 m", "500 m", "600 m"],
"correta": 3,
"eq": "Se João andou 300 m e depois mais 200 m, ele andou?"
}, {
"alts": ["1000", "100", "10", "500", "50"],
"correta": 0,
"eq": "1 km equivale a quantos metros?"
}, {
"alts": ["20", "13", "12", "24", " 23 horas, 56 minutos e 4 segundos"],
"correta": 4,
"eq": "1 dia tem?"
}, {
"alts": ["3.265", "3.262", "3.263", "3.266", "3.267"],
"correta": 3,
"eq": "1234+2032=?"
}]

